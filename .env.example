# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_tools_library

# Authentication
NEXTAUTH_SECRET=your-secret-key-here-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# OpenAI API
OPENAI_API_KEY=sk-your-api-key-here

# Video Provider APIs (configure as needed)
VIDEO_PROVIDER_TYPE=custom
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_API_URL=

# Voice/Audio Provider
VOICE_PROVIDER_API_KEY=
VOICE_PROVIDER_TYPE=openai

# Cloud Storage (S3-compatible)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=ai-tools-library
AWS_S3_ENDPOINT=https://s3.amazonaws.com

# Redis (for job queue)
REDIS_URL=redis://localhost:6379

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=AI Tools Library
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# Security
MAX_FILE_SIZE=5000000000
MAX_UPLOAD_FILES=100
API_RATE_LIMIT_WINDOW=900000
API_RATE_LIMIT_MAX_REQUESTS=100

# FFmpeg (for video editing)
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
